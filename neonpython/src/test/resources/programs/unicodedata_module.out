normalize str 1 !! TypeError 'normalize() argument 2 must be str, not int'
normalize one !! TypeError 'normalize expected 2 arguments, got 1'
is_normalized NFX !! ValueError 'invalid normalization form'
is_normalized NFX empty -> True
normalize NFX empty -> ''
lookup () !! TypeError 'unicodedata.lookup() takes exactly one argument (0 given)'
lookup 1 !! TypeError "a bytes-like object is required, not 'int'"
lookup bytearray !! TypeError 'lookup() argument must be read-only bytes-like object, not bytearray'
lookup surrogate !! UnicodeEncodeError "'utf-8' codec can't encode character '\\ud800' in position 0: surrogates not allowed"
UCD() !! TypeError "cannot create 'unicodedata.UCD' instances"
UCD subclass !! TypeError "type 'unicodedata.UCD' is not an acceptable base type"
unidata_version set !! AttributeError 'readonly attribute'
UCD attribute !! AttributeError "'unicodedata.UCD' object has no attribute 'foo' and no __dict__ for setting new attributes"
