'a[1].b' -> ('a', [(False, 1), (True, 'b')])
'12.real' -> (12, [(True, 'real')])
'' -> ('', [])
'x[a][b]' -> ('x', [(False, 'a'), (False, 'b')])
'[0]' -> ('', [(False, 0)])
'a.' !! ValueError Empty attribute in format string
'a[0]x' !! ValueError Only '.' or '[' may follow ']' in format field specifier
'a[0' !! ValueError Missing ']' in format string
