'{0!r' !! ValueError unmatched '{' in format spec
'{[}' !! ValueError expected '}' before end of string
'{a{b}' !! ValueError unexpected '{' in field name
'{0!rx}' !! ValueError expected ':' after conversion specifier
'0' -> (0, [])
